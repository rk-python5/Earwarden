# Source this from inside the Earwarden repo, once in every new terminal:
#
#     source dev/activate
#
# It keeps everything Earwarden installs inside this repo (decisions.md, D-013), in .tools/, which
# git ignores:
#
#   .tools/uv-venv/      a venv that holds uv itself, made on first use with the Mac's python3
#   .tools/bin/          uv and uvx, put on PATH for this terminal only
#   .tools/python/       the Python 3.11 that uv downloads
#   .tools/cache/        uv's cache, including the environments the spike scripts run in
#   .tools/huggingface/  models the spikes download
#
# The project's own libraries go into .venv/ as usual. Nothing goes into your home folder or your
# shell profile. Delete .tools/ and .venv/ to remove all of it.

earwarden_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$earwarden_root" ] || [ ! -f "$earwarden_root/dev/activate" ]; then
    echo "Run 'source dev/activate' from inside the Earwarden repo." >&2
    return 1 2>/dev/null || exit 1
fi
earwarden_tools="$earwarden_root/.tools"

export UV_CACHE_DIR="$earwarden_tools/cache"
export UV_PYTHON_INSTALL_DIR="$earwarden_tools/python"
export UV_PYTHON_BIN_DIR="$earwarden_tools/python/bin"
export UV_TOOL_DIR="$earwarden_tools/uv-tools"
export UV_TOOL_BIN_DIR="$earwarden_tools/bin"
export UV_PYTHON_PREFERENCE="only-managed"
export HF_HOME="$earwarden_tools/huggingface"

if [ ! -x "$earwarden_tools/uv-venv/bin/uv" ]; then
    echo "First run: installing uv into $earwarden_tools/uv-venv"
    if ! python3 -m venv "$earwarden_tools/uv-venv" ||
        ! "$earwarden_tools/uv-venv/bin/python" -m pip install --quiet --no-cache-dir \
            --disable-pip-version-check uv; then
        echo "Couldn't install uv; see the messages above." >&2
        return 1 2>/dev/null || exit 1
    fi
fi
mkdir -p "$earwarden_tools/bin"
ln -sf "$earwarden_tools/uv-venv/bin/uv" "$earwarden_tools/bin/uv"
ln -sf "$earwarden_tools/uv-venv/bin/uvx" "$earwarden_tools/bin/uvx"
case ":$PATH:" in
    *":$earwarden_tools/bin:"*) ;;
    *) export PATH="$earwarden_tools/bin:$PATH" ;;
esac

echo "Earwarden tools ready: $(uv --version), everything inside $earwarden_tools"
unset earwarden_root earwarden_tools
